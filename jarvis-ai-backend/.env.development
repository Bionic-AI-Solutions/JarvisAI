# Development Environment Configuration
# Copy this to .env for local development with docker-compose

NODE_ENV=development
PORT=3000

# Redis Configuration (matches docker-compose.yml)
REDIS_SENTINELS=localhost:26379,localhost:26380,localhost:26381
REDIS_SENTINEL_NAME=mymaster
REDIS_PASSWORD=jarvis-dev-password
REDIS_DB=0

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# Rate Limiting (relaxed for development)
RATE_LIMIT_PER_CUSTOMER=10000
RATE_LIMIT_PER_IP=50000
RATE_LIMIT_WINDOW_MS=3600000

# Logging (verbose for development)
LOG_LEVEL=debug
LOG_FORMAT=text

# API Configuration
API_VERSION=2.0.0
API_TITLE=Jarvis AI Backend (Dev)
